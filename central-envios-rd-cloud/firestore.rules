rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function bootstrapAdmin() {
      return signedIn()
        && request.auth.token.email == 'shaniwaris80@gmail.com';
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn()
        && profile().data.active == true;
    }

    function role() {
      return profile().data.role;
    }

    function isAdmin() {
      return (activeUser() && role() == 'admin') || bootstrapAdmin();
    }

    function isCollector() {
      return activeUser()
        && (role() == 'admin' || role() == 'collector');
    }

    function isMadrid() {
      return activeUser()
        && (role() == 'admin' || role() == 'madrid');
    }

    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create: if isAdmin()
        || (
          request.auth.uid == userId
          && bootstrapAdmin()
          && request.resource.data.role == 'admin'
          && request.resource.data.active == true
        );

      allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if activeUser() || bootstrapAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /weeks/{weekId} {
      allow read: if activeUser() || bootstrapAdmin();
      allow create: if isAdmin() || isCollector();
      allow update: if isAdmin() || isMadrid();
      allow delete: if isAdmin();
    }

    match /shipments/{shipmentId} {
      allow read: if activeUser();
      allow create: if isCollector()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isCollector()
        || (isMadrid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'parcels', 'updatedBy', 'updatedByEmail', 'updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    match /senders/{senderId} {
      allow read: if activeUser();
      allow create, update: if isCollector();
      allow delete: if isAdmin();
    }

    match /receivers/{receiverId} {
      allow read: if activeUser();
      allow create, update: if isCollector();
      allow delete: if isAdmin();
    }

    match /senderReceivers/{relationId} {
      allow read: if activeUser();
      allow create, update: if isCollector();
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if activeUser();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
